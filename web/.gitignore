# Firmware and emulator binaries are never committed. Both are produced by
# scripts/wasm/: stage-assets.py fills public/assets/, build-qemu.sh fills
# emulator/.
# Anchored: an unanchored "emulator/" would also swallow src/emulator/, which is
# frontend source and must be committed.
/public/assets/
/emulator/
node_modules/
/dist/

# Browser test pages under public/*-smoke/ and public/jit-boot/ are SOURCE and
# are committed. What is staged next to them is not: Apple firmware and a 52 MB
# emulator build, both reproducible.
/public/*/bootrom
/public/*/iboot.bin
/public/*/nor.bin
/public/*/nand.pack
/public/*/qemu-system-arm.js
/public/*/qemu-system-arm.wasm
# A post-boot migration stream, produced by scripts/wasm/snapshot-probe.py
# --keep-state. ~24 MiB, reproducible, never committed.
/public/*/state
# Per-build snapshots from scripts/wasm/build-snapshot.py: a ~57 MiB migration
# stream (11 MiB Brotli'd), reproducible from the firmware and the engine.
/public/*/snapshots/
# Per-build firmware staged beside the page (symlinks into m68ap-artifacts).
/public/*/fw/

# Session B's bench harness (web/bench-b/index.html) is SOURCE; the firmware
# and emulator symlinked beside it are not, same rule as public/*.
/bench-b/bootrom
/bench-b/iboot.bin
/bench-b/nor.bin
/bench-b/qemu-system-arm.js
/bench-b/qemu-system-arm.wasm
# Per-build firmware, symlinked in as web/bench-b/<BUILD>/{bootrom,iboot.bin,
# nor.bin,nand.pack}.
/bench-b/*/

# Chunked NAND asset sets: produced by scripts/wasm/chunk-pack.py, ~64 MiB per
# firmware version.
/chunked/
