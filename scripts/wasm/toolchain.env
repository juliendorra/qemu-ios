# Pinned toolchain for the browser/WebAssembly port.
#
# Sourced by every script under scripts/wasm/.  Changing a value here is a
# toolchain change: rebuild the image and re-record the measurements in
# BROWSER_WASM_STATUS.md.
#
# The versions mirror QEMU 11.0.2's own tests/docker/dockerfiles/
# emsdk-wasm64-cross.docker defaults.  They are repeated here so the build
# scripts pass them explicitly and a drift in the upstream recipe cannot
# silently change our output.

# Native (default, Docker-free) toolchain location, relative to the repo root.
WASM_TOOLCHAIN_DIR=${WASM_TOOLCHAIN_DIR:-.wasm-toolchain}

# Only used by the optional container path (scripts/wasm/build-toolchain.sh).
WASM_BUILDER_IMAGE=${WASM_BUILDER_IMAGE:-qemu-ipod-wasm-builder:emsdk-4.0.10}

WASM_EMSDK_VERSION=${WASM_EMSDK_VERSION:-4.0.10}
WASM_ZLIB_VERSION=${WASM_ZLIB_VERSION:-1.3.1}

# emsdk requires Python >= 3.10 and macOS Command Line Tools ships 3.9.6.
# Rather than changing the host's Python, the toolchain pins a standalone
# CPython of its own.  Set WASM_PYTHON to an existing >= 3.10 interpreter to
# skip the download entirely.
WASM_PYTHON_VERSION=${WASM_PYTHON_VERSION:-3.12.13}
WASM_PYTHON_RELEASE=${WASM_PYTHON_RELEASE:-20260718}
WASM_GLIB_MINOR_VERSION=${WASM_GLIB_MINOR_VERSION:-2.84}
WASM_GLIB_VERSION=${WASM_GLIB_VERSION:-2.84.0}
WASM_PIXMAN_VERSION=${WASM_PIXMAN_VERSION:-0.44.2}
WASM_FFI_VERSION=${WASM_FFI_VERSION:-v3.5.2}

# Build directory for the Emscripten target, relative to the repository root.
# Kept separate from build-ipod11/ so the native reference build stays intact.
WASM_BUILD_DIR=${WASM_BUILD_DIR:-build-wasm}

# The only target we need.  The iPod/iPhone machines are ARM32 softmmu.
WASM_TARGET_LIST=${WASM_TARGET_LIST:-arm-softmmu}
