{
  "_comment": "Richer first-guess modem: answers the standard AT init/status queries a phone stack usually issues (identity, SIM, signal, registration) instead of a bare OK. Hypothesis candidate, to be corrected from real traces.",
  "default": "\r\nOK\r\n",
  "non_at": null,
  "rules": [
    {"match": "(?i)^at\\+xdrv=9,1,(\\d+)",
     "response": "\r\n+XDRV: 9,1,0,{1},NULL\r\n\r\nOK\r\n",
     "note": "baseband NVRAM read -> empty store"},
    {"match": "(?i)^at\\+xdrv=4,",
     "response": "\r\nOK\r\n",
     "note": "vibrator"},
    {"match": "(?i)^at\\+cgmi",
     "response": "\r\nINFINEON\r\n\r\nOK\r\n",
     "note": "manufacturer id"},
    {"match": "(?i)^at\\+cgmm",
     "response": "\r\nS-GOLD2\r\n\r\nOK\r\n",
     "note": "model id"},
    {"match": "(?i)^at\\+cgmr",
     "response": "\r\n04.05.04_G\r\n\r\nOK\r\n",
     "note": "firmware revision (1.1.4 baseband)"},
    {"match": "(?i)^at\\+cgsn",
     "response": "\r\n012345678901237\r\n\r\nOK\r\n",
     "note": "IMEI"},
    {"match": "(?i)^at\\+xgendata",
     "response": "\r\n+XGENDATA: \"DEBUG_BB 04.05.04_G\"\r\n\r\nOK\r\n",
     "note": "baseband build string"},
    {"match": "(?i)^at\\+cpin\\?",
     "response": "\r\n+CPIN: READY\r\n\r\nOK\r\n",
     "note": "SIM PIN state"},
    {"match": "(?i)^at\\+creg\\?",
     "response": "\r\n+CREG: 0,1\r\n\r\nOK\r\n",
     "note": "network registration"},
    {"match": "(?i)^at\\+csq",
     "response": "\r\n+CSQ: 24,0\r\n\r\nOK\r\n",
     "note": "signal quality"},
    {"match": "(?i)^at\\+cops\\?",
     "response": "\r\n+COPS: 0,0,\"QEMU\",0\r\n\r\nOK\r\n",
     "note": "carrier registration"},
    {"match": "(?i)^at\\+cimi",
     "response": "\r\n001010123456789\r\n\r\nOK\r\n",
     "note": "IMSI"},
    {"match": "(?i)^at\\+xcallstat=(\\d)",
     "response": "\r\nOK\r\n",
     "set": {"xcallstat": "{1}"},
     "note": "call status notifications toggle"},
    {"match": "(?i)^atd.*",
     "response": "\r\nOK\r\n\r\n+XCALLSTAT: 1,0\r\n",
     "if": {"var": "xcallstat", "equals": "1"},
     "note": "dial with call-status reporting"},
    {"match": "(?i)^atd.*",
     "response": "\r\nOK\r\n",
     "note": "dial"}
  ]
}
