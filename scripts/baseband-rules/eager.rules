at+xgendata	\r\n+XGENDATA: "DEBUG_BB 04.05.04_G"\r\n\r\nOK\r\n
at+cpin?	\r\n+CPIN: READY\r\n\r\nOK\r\n
at+creg?	\r\n+CREG: 0,1\r\n\r\nOK\r\n
at+csq	\r\n+CSQ: 24,0\r\n\r\nOK\r\n
